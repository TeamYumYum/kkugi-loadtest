# deploy/docker-compose.yml이 읽는 값. 이 파일을 같은 폴더의 .env로 복사해 채운다.
# .env는 실제 주소가 들어가므로 커밋하지 않는다(.gitignore에 있다). 필수 값이 비면 compose가 바로 멈춘다.

# 대상 서비스 도메인(https:// 없이). 두 Worker 모두 https://<이 값>으로 보낸다
APP_DOMAIN=

# 앱 서버의 프라이빗 IP. worker-private 컨테이너만 APP_DOMAIN을 이 주소로 해석해 프라이빗 경로로 보낸다.
# worker-public은 매핑 없이 공인 주소로 간다
APP_PRIVATE_IP=

# Master가 띄우는 전체 User(실행기) 수. 연결된 Worker들에 고르게 나뉜다.
# Worker마다 필요한 실행기 수는 일정 로그에 남는다. 모든 Worker가 같은 수를 받으므로
# 가장 바쁜 Worker의 필요량 × Worker 수 이상으로 두고, 노트북 Worker를 붙이면 다시 계산한다. 가정
# 8,000명 구성(Worker 12개)에서도 가장 바쁜 Worker는 batch-private다. 950명의 몰아 기록 세션(약 44초)이 23:00-23:30에
# 몰려 동시 세션이 약 22개이고, 여유 2배를 곱해 Worker마다 45개, 전체 540개(12 × 45)를 둔다. 일정 로그의 추정(22-23개)은
# 세션이 한 시간에 고르게 퍼진다고 보므로 이 Worker에서는 절반으로 나온다.
# 다음으로 바쁜 dieter-extra-private(3,610명)는 12시나 18시에 추정 10-11개라 45개 안에 든다.
KKUGI_USERS=540

# 경보와 하루 요약을 보낼 Mattermost Incoming Webhook 주소. 비밀값이라 이 파일과 채팅에 붙이지 않는다.
# 비어 있으면 compose가 멈춘다(alerts 서비스). 만드는 법은 README의 "경보"
KKUGI_MM_WEBHOOK_URL=

# 초당 User 생성 수. User는 계정이 아니라 실행기라 천천히 띄울 이유가 없다. 가정
KKUGI_SPAWN_RATE=10
